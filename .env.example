# Application Configuration
PORT=5001
NODE_ENV=production

# Database Connection (SQLite local file or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret (Use a strong random secret in production)
JWT_SECRET="your_jwt_secret_key_here_change_in_production"

# AI Assistant Configuration (Optional: OpenRouter / OpenAI compatible provider)
AI_API_KEY=""
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_MODEL="openai/gpt-4o-mini"
